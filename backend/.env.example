# Copiar este archivo como .env y rellenar con las credenciales reales.
# El .env NUNCA se sube al repositorio.

MONGODB_URI=
DB_NAME=AplicativoEducativo
PORT=3001

# Opcional. Sin esto el sistema funciona igual: el modelo sigue prediciendo y la
# interfaz muestra los factores calculados. Lo unico que se pierde es la
# redaccion en lenguaje natural.
# Se saca gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
